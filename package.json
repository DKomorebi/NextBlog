{
  "name": "fieldnotes-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "dev:web": "next dev --webpack",
    "dev:api": "tsx watch server/index.ts",
    "start": "concurrently -k \"pnpm start:api\" \"pnpm start:web\"",
    "start:api": "tsx server/production.ts",
    "start:web": "next start",
    "db:migrate": "tsx server/manage.ts migrate",
    "db:seed": "tsx server/manage.ts seed",
    "admin": "tsx server/manage.ts admin",
    "test:api": "tsx --test server/app.test.ts server/registration.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typeorm": "~0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "daisyui": "^5.8.1",
    "postcss": "^8.5.0",
    "serve": "^14.2.4",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
